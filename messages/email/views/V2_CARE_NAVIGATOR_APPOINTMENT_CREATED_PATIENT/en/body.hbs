{{#partial "preheader"}}
	Your Care Navigator appointment is confirmed for {{appointmentStartDateDescription}} at {{appointmentStartTimeDescription}}.
{{/partial}}

{{#partial "content"}}
	<table width="100%" border="0" cellspacing="0" cellpadding="0" role="presentation">
		<tr>
			<td align="left" style="font-family:'SF Pro Display', 'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:28px; line-height:36px; font-weight:700; color:{{colors.n900}};">
				Your Care Navigator appointment is confirmed
			</td>
		</tr>
		<tr><td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td></tr>
		<tr>
			<td align="left" style="font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:16px; line-height:24px; color:{{colors.n900}};">
				Hello{{#if patientName}} {{patientName}}{{/if}},<br /><br />
				Your video appointment with a Care Navigator is scheduled for <strong>{{appointmentStartDateDescription}}</strong> at <strong>{{appointmentStartTimeDescription}}</strong>.
			</td>
		</tr>
		<tr><td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td></tr>
		<tr>
			<td align="left">
				<table border="0" cellspacing="0" cellpadding="0" role="presentation">
					<tr>
						<td align="center" bgcolor="{{colors.p500}}" style="background-color:{{colors.p500}}; border-radius:999px;">
							<a href="{{{patientAppointmentUrl}}}" target="_blank" style="display:inline-block; font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:14px; line-height:20px; font-weight:600; color:#FFFFFF; text-decoration:none; padding:11px 21px; border-radius:999px;">Join appointment</a>
						</td>
					</tr>
				</table>
			</td>
		</tr>
		<tr><td height="16" style="height:16px; line-height:16px; font-size:1px;">&nbsp;</td></tr>
		<tr>
			<td align="left" style="font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:14px; line-height:20px; color:{{colors.n900}};">
				Need to change your plans? <a href="{{{cancelUrl}}}" target="_blank" style="color:{{colors.p500}}; text-decoration:underline;">Cancel appointment</a>.
			</td>
		</tr>
		{{#if appointmentCreatedPatientEmailBodyHtml}}
			<tr><td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td></tr>
			<tr>
				<td align="left" style="font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:16px; line-height:24px; color:{{colors.n900}};">
					{{{appointmentCreatedPatientEmailBodyHtml}}}
				</td>
			</tr>
		{{/if}}
		<tr><td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td></tr>
		<tr>
			<td align="left" style="font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:14px; line-height:20px; color:{{colors.n900}};">
				Please do not reply to this email. This mailbox is not monitored.
			</td>
		</tr>
	</table>
{{/partial}}

{{#partial "footer"}}
	You are receiving this transactional email because a Care Navigator appointment was scheduled through {{platformName}}.
{{/partial}}

{{> layouts/en/v2}}
