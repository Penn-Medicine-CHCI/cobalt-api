{{#partial "preheader"}}
	A patient order for {{institutionName}} needs safety review.
{{/partial}}

{{#partial "content"}}
	<table width="100%" border="0" cellspacing="0" cellpadding="0" role="presentation">
		<tr>
			<td align="left" style="font-family:'SF Pro Display', 'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:28px; line-height:36px; font-weight:700; color:{{colors.n900}};">
				{{institutionName}} safety review needed
			</td>
		</tr>
		<tr><td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td></tr>
		<tr>
			<td align="left" style="font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:16px; line-height:24px; color:{{colors.n900}};">
				A patient submitted an assessment response that requires review. Sign in to review {{institutionName}} order <strong>{{patientOrderReferenceNumber}}</strong> and coordinate any appropriate follow-up.
			</td>
		</tr>
		<tr><td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td></tr>
		<tr>
			<td align="left">
				<table border="0" cellspacing="0" cellpadding="0" role="presentation">
					<tr>
						<td align="center" bgcolor="{{colors.p500}}" style="background-color:{{colors.p500}}; border-radius:999px;">
							<a href="{{{staffPatientOrderUrl}}}" target="_blank" style="display:inline-block; font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:14px; line-height:20px; font-weight:600; color:#FFFFFF; text-decoration:none; padding:11px 21px; border-radius:999px;">Review order</a>
						</td>
					</tr>
				</table>
			</td>
		</tr>
		<tr><td height="24" style="height:24px; line-height:24px; font-size:1px;">&nbsp;</td></tr>
		<tr>
			<td align="left" style="font-family:'SF Pro Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif; font-size:14px; line-height:20px; color:{{colors.n900}};">
				Please do not reply to this email. This mailbox is not monitored.
			</td>
		</tr>
	</table>
{{/partial}}

{{#partial "footer"}}
	You are receiving this transactional email because you are a safety-review contact for {{institutionName}} in {{platformName}}.
{{/partial}}

{{> layouts/en/v2}}
